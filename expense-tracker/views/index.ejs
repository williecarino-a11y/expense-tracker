<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Tracker</title>
    <!-- Tailwind CSS CDN for rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100 min-h-screen transition-colors duration-200">

    <!-- TOP TITLE HEADER (Separate Entity) -->
    <header class="w-full bg-gray-900 text-white shadow-md py-4 px-6 flex justify-between items-center">
        <h1 class="text-2xl font-bold tracking-wide">Expense Tracker</h1>
        
        <!-- Settings Dropdown Container -->
        <div class="relative">
            <button id="settingsBtn" class="p-2 text-gray-300 hover:text-white focus:outline-none">
                <i class="fa-solid fa-ellipsis-vertical text-xl"></i>
            </button>
            
            <!-- Dropdown Menu -->
            <div id="settingsMenu" class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 z-50 overflow-hidden">
                <div class="py-1">
                    <!-- Upgrade to Pro -->
                    <a href="#upgrade" class="flex items-center px-4 py-3 text-sm text-amber-600 dark:text-amber-400 hover:bg-gray-100 dark:hover:bg-gray-700 font-semibold border-b border-gray-100 dark:border-gray-700">
                        <i class="fa-solid fa-crown mr-3"></i> Upgrade to Pro
                    </a>
                    <!-- Pro Features Modal Trigger -->
                    <button onclick="openProFeaturesModal()" class="w-full text-left flex items-center px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <i class="fa-solid fa-star mr-3 text-indigo-500"></i> Pro Features
                    </button>
                    <!-- Dark Mode Toggle -->
                    <div class="flex items-center justify-between px-4 py-3 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer" onclick="toggleDarkMode()">
                        <span class="flex items-center"><i class="fa-solid fa-moon mr-3 text-blue-500"></i> Dark Mode</span>
                        <div id="darkModeIndicator" class="text-xs px-2 py-0.5 rounded bg-gray-200 dark:bg-gray-600 font-medium">Off</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN DASHBOARD BODY -->
    <main class="max-w-4xl mx-auto p-4 sm:p-6 space-y-6">

        <!-- Search & Custom Filters Section -->
        <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row gap-3">
                <!-- Search Input -->
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" id="searchInput" placeholder="Search expenses..." class="w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                </div>
                <!-- Categories Dropdown -->
                <div class="sm:w-48">
                    <select id="categoryFilter" class="w-full py-2 px-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                        <option value="">All Categories</option>
                        <option value="food">Food & Dining</option>
                        <option value="bills">Bills & Utilities</option>
                        <option value="entertainment">Entertainment</option>
                        <option value="transport">Transport</option>
                    </select>
                </div>
            </div>
            <!-- Sort Order Filter -->
            <div>
                <select id="sortFilter" class="w-full sm:w-48 py-2 px-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                    <option value="highest">Highest Amount</option>
                    <option value="lowest">Lowest Amount</option>
                </select>
            </div>
        </div>

        <!-- Summary / Totals Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border-l-4 border-emerald-500">
                <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold">Total Income</p>
                <h3 id="totalIncomeDisplay" class="text-xl font-bold mt-1 text-emerald-600 dark:text-emerald-400">₦0.00</h3>
            </div>
            <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border-l-4 border-rose-500">
                <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold">Total Expenses</p>
                <h3 id="totalExpenseDisplay" class="text-xl font-bold mt-1 text-rose-600 dark:text-rose-400">₦0.00</h3>
            </div>
            <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border-l-4 border-indigo-500">
                <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold">Monthly Budget Left</p>
                <h3 id="budgetLeftDisplay" class="text-xl font-bold mt-1">₦0.00</h3>
            </div>
        </div>

        <!-- Action Forms: Add Income / Expense & Budget -->
        <div class="bg-white dark:bg-gray-800 p-5 rounded-xl shadow-sm">
            <h2 class="text-lg font-semibold mb-4 border-b pb-2 border-gray-100 dark:border-gray-700">Add Transaction / Budget</h2>
            <form id="transactionForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Description</label>
                    <input type="text" id="descInput" required placeholder="e.g., Grocery shopping" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Amount (₦)</label>
                    <input type="number" id="amountInput" required placeholder="0.00" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Type</label>
                    <select id="typeInput" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-sm">
                        <option value="expense">Expense</option>
                        <option value="income">Income</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Category</label>
                    <select id="categoryInput" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-sm">
                        <option value="food">Food & Dining</option>
                        <option value="bills">Bills & Utilities</option>
                        <option value="entertainment">Entertainment</option>
                        <option value="transport">Transport</option>
                    </select>
                </div>
                <div class="sm:col-span-2">
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg text-sm transition duration-150">
                        Add Transaction
                    </button>
                </div>
            </form>
        </div>

        <!-- Transaction List Section -->
        <div class="bg-white dark:bg-gray-800 p-5 rounded-xl shadow-sm">
            <h2 class="text-lg font-semibold mb-4 border-b pb-2 border-gray-100 dark:border-gray-700">Recent Transactions</h2>
            <div id="transactionList" class="divide-y divide-gray-100 dark:divide-gray-700 max-h-64 overflow-y-auto">
                <p class="text-sm text-gray-400 text-center py-4">No transactions recorded yet.</p>
            </div>
        </div>

    </main>

    <!-- Pro Features Modal -->
    <div id="proModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 dark:border-gray-700 space-y-4">
            <div class="flex justify-between items-center border-b pb-3 border-gray-100 dark:border-gray-700">
                <h3 class="text-lg font-bold flex items-center text-amber-500">
                    <i class="fa-solid fa-crown mr-2"></i> Pro Features
                </h3>
                <button onclick="closeProFeaturesModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
                <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-3"></i> Advanced budget alerts & analytics graphs</li>
                <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-3"></i> Multi-currency support & auto-sync</li>
                <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-3"></i> Unlimited custom export reports (PDF/CSV)</li>
                <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-3"></i> Priority customer support access</li>
            </ul>
            <button class="w-full bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-semibold py-2.5 rounded-xl shadow-lg transition">
                Unlock Pro Now
            </button>
        </div>
    </div>

    <!-- JavaScript Handlers -->
    <script>
        const settingsBtn = document.getElementById('settingsBtn');
        const settingsMenu = document.getElementById('settingsMenu');

        settingsBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            settingsMenu.classList.toggle('hidden');
        });

        window.addEventListener('click', () => {
            if (!settingsMenu.classList.contains('hidden')) {
                settingsMenu.classList.add('hidden');
            }
        });

        function toggleDarkMode() {
            const html = document.documentElement;
            const indicator = document.getElementById('darkModeIndicator');
            html.classList.toggle('dark');
            
            if (html.classList.contains('dark')) {
                indicator.textContent = 'On';
                indicator.className = 'text-xs px-2 py-0.5 rounded bg-indigo-900 text-indigo-200 font-medium';
                localStorage.setItem('theme', 'dark');
            } else {
                indicator.textContent = 'Off';
                indicator.className = 'text-xs px-2 py-0.5 rounded bg-gray-200 dark:bg-gray-600 font-medium';
                localStorage.setItem('theme', 'light');
            }
        }

        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
            document.getElementById('darkModeIndicator').textContent = 'On';
            document.getElementById('darkModeIndicator').className = 'text-xs px-2 py-0.5 rounded bg-indigo-900 text-indigo-200 font-medium';
        }

        function openProFeaturesModal() {
            document.getElementById('proModal').classList.remove('hidden');
            settingsMenu.classList.add('hidden');
        }

        function closeProFeaturesModal() {
            document.getElementById('proModal').classList.add('hidden');
        }
    </script>
</body>
</html>
